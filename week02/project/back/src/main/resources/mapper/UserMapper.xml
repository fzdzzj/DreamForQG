<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qg.dormrepair.mapper.UserDao">

    <!--更新用户    -->
    <update id="update" parameterType="com.qg.dormrepair.pojo.User">
        update user
        <set>
            <if test="pwd != null">pwd = #{pwd},</if>
            <if test="role != null">role = #{role},</if>
            <if test="dormBuilding != null">dorm_building = #{dormBuilding},</if>
            <if test="dormRoom != null">dorm_room = #{dormRoom}</if>
        </set>
        where account = #{account}
    </update>

</mapper>
